root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# oxfmt.config.ts의 printWidth와 반드시 같은 값을 유지한다.
# 어긋나면 에디터와 포매터가 서로 다른 위치에서 줄을 접는다.
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}]
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2
